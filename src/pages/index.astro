---
import Banner from '../components/Banner';
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

import morena from '../assets/banner/morena.png';
import homesick from '../assets/banner/homesick.png';
import grime from '../assets/banner/grime.png';
import morena2 from '../assets/banner/morena2.png';

const optMorena = await getImage({ src: morena, format: 'webp' });
const optHomesick = await getImage({ src: homesick, format: 'webp' });
const optGrime = await getImage({ src: grime, format: 'webp' });
const optMorena2 = await getImage({ src: morena2, format: 'webp' });

const bannerImages = [
  optMorena.src,
  optHomesick.src,
  optGrime.src,
  optMorena2.src
];
---

<Layout>
	<div class="container">

		<Banner optimizedImages={bannerImages} client:load />
		<!-- <div class="centered">
			<span  class="big">This is my <br> portfolio.</span>
			<p class="small">Welcome :)</p>
		</div> -->
		<!-- <img src="src/assets/banner2.png"/> -->
		<!-- <img class="banner" src="/banner/morena.png"/> -->
		<!-- <img class="banner" src="/banner/homesick.png" style="object-position: top;"/> -->
		 
	</div>
	<main>
	 <div class="about" id="about">
		<div>
			<h2>About Me</h2>
			<div class="intro">
				<div>

					
					<p>
						My name is Kateřina Plešová and I am a designer and illustrator.
						I have studied both multimedia art and computer science, which allows<nobr> me to </nobr>combine my technical and creative skills.
					</p>
					<h3>Education</h3>
					<ul>
						<li>
							<p class="education">
								Mendel university in Brno
							</p>
							<span>
								Bachelor's Degree in Open Informatics
							</span>
						</li>
						<li>
							<p class="education">
								The Secondary School of Applied Arts<nobr> in </nobr>Uherské Hradiště
							</p>
							<span>
								Specialisation in Multimedia
							</span>
						</li>
					</ul>
				</div>
				<img src="/portrait.png" style="width: 20em; height: 25em; object-fit: cover;"/>
			</div>
			<div class="skillset">
			<div>
				<h3>Tools</h3>
				<ul>
					<li>Figma</li>
					<li>Adobe Suite</li>
					<li>Affinity</li>
				</ul>
			</div>
			<div>
				<h3>Skills</h3>
				<ul>
					<li>UX/UI design</li>
					<li>Design systems</li>
					<li>HTML, CSS</li>
				</ul>
			</div>
			<div id="contact">
				<h3>Contact</h3>
				<ul>
					<li>
						<a href="mailto:plesovakaterina@gmail.com">plesovakaterina@gmail.com</a>
					</li>
					<li>
						<a target="_blank" rel="noopener noreferrer" href="https://www.instagram.com/kata_plsv/">IG: @kata_plsv</a>
					</li>
				</ul>
			</div>
			</div>
		</div>
		
		<!-- <div id="contact">

			<h2>Contact</h2>
			<p>You can contact me at <a
				href="mailto:plesovakaterina@gmail.com">plesovakaterina@gmail.com</a> or through Instagram at <a
				target="_blank" rel="noopener noreferrer" href="https://www.instagram.com/kata_plsv/">@kata_plsv</a>.</p>
		</div> -->
		
	</div>
	</main>
</Layout>

<style>
	.about {
		/* max-width: 960px;
		width: 100%;
        margin: 0 auto; */
		/* padding: 2rem 4rem; */
	}
	h2 {
		font-size: 2rem;
		margin-bottom: 1rem;
		text-decoration: var(--secondary) underline;
		text-underline-offset: 6px;
		text-decoration-thickness: 6px;
	}

	h3 {
		font-size: 1.5rem;
		margin-bottom: 1rem;
		/* text-decoration: var(--secondary) underline;
		text-underline-offset: 6px;
		text-decoration-thickness: 4px; */
	}

	p {
		font-size: 1.2rem;
		margin-top: 0;
		line-height: 1.8rem;
	}
	li {
		font-size: 1.2rem;
		line-height: 1.6;
		width: fit-content;
	}
	.education {
		font-weight: bold;
	}
	span {
		font-size: 0.9em;
	}
	ul {
		list-style-type: square;
	}
	ul p {
		margin: 0.4em 0;
	}
	img {
		width: 100%;
		/* height: 80%; */
		object-fit: cover;
		object-position: top;
		border-radius: 5px;
		
	}
	.container {
		width: 100%;
		/* height: 20em; */
		/* morena height */
		/* height: 25em; */
		overflow: hidden;
		position: relative;
		text-align: left;
		color: white;
	}
	.centered {
		padding: 0;
		/* font-size: 2.5em; */
		position: absolute;
		top: 50%;
		right: 60%;
		transform: translate(-50%, -50%);
	}
	.big {
		font-size: 2.5em;
	}
	.small {
		font-size: 1em;
	}
	.banner {
		height: 28em;
		/* box-shadow: 0 2px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19); */
	}
	.intro {
		display: flex;
		gap: 4rem;
	}
	.skillset {
		display: flex;
		justify-content: space-between;
		/* gap: 4rem; */
	}
	a {
		color: black
	}

	@media screen and (max-width: 768px) {
	  .intro {
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	  }
	  main {
		padding: 2rem 1rem;
	  }
	  h2 {
		font-size: 1rem;
	  }
	  h3 {
		font-size: 0.8rem;
		margin: 0;
	  }
	  p {
		font-size: 12px;
		line-height: normal;
	  }
	  span {
		font-size: 12px;
	  }
	  li {
		font-size: 12px;
	  }
	  ul {
		margin: 0
	  }
	  .skillset {
		flex-direction: column;
	  }
	  img {
		display: none;
	  }
	}
</style>
