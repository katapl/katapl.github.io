					<li>Adobe Suite</li>
					<li>Affinity</li>
				</ul>
			</div>
			<div>
				<h3>Skills</h3>
				<ul>
					<li>UX/UI design</li>
					<li>Design systems</li>
					<li>HTML, CSS</li>
				</ul>
			</div>
			<div>
				<h3>Contact</h3>
