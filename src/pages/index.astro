</Layout>

<style>
	.about {
		padding: 2rem 17rem 4rem 17rem;
	
	}
	h2 {
		font-size: 2rem;
		margin-bottom: 1rem;
	}

	h3 {
		font-size: 1.5rem;
		margin-bottom: 1rem;
	}

	p {
		font-size: 1.2rem;
		line-height: 1.8rem;
	}
	li {
		font-size: 1.2rem;
		line-height: 1.6;
	}
	.education {
		font-weight: bold;
	}
	span {
		font-size: 0.9em;
	}
	ul {
		list-style-type: square;
	}
	ul p {
		margin: 0.4em 0;
	}
	img {
		width: 100%;
		/* height: 50%; */
		object-fit: cover;
		object-position: top;
	}
	.container {
		width: 100%;
		/* height: 20em; */
		/* morena height */
		/* height: 25em; */
		overflow: hidden;
		position: relative;
		text-align: left;
		color: white;
	}
	.centered {
		padding: 0;
		/* font-size: 2.5em; */
		position: absolute;
		top: 50%;
		right: 60%;
		transform: translate(-50%, -50%);
	}
	.big {
		font-size: 2.5em;
	}
	.small {
		font-size: 1em;
	}
	.skillset {
		display: flex;
	}
	.banner {
		height: 28em;
		/* box-shadow: 0 2px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19); */
	}
	.intro {
		display: flex;
		gap: 4rem;
	}
	.skillset {
		display: flex;
		justify-content: space-between;
		padding-top: 0.5em;
		/* gap: 4rem; */
	}
	a{
		color: black
	}
</style>
