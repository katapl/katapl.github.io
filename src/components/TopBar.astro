---
import HeaderLink from './HeaderLink.astro';
---

<header>
    <nav class="topnav"id="myTopnav">
        <h1><a href="/">plesova_katerina</a></h1>
        <div class="topbar-center">
            <HeaderLink href="/ux">UX DESIGN</HeaderLink>
            <HeaderLink href="/art">ILLUSTRATION</HeaderLink>
            <HeaderLink href="/graphic-design">GRAPHIC DESIGN</HeaderLink>
        </div>
        <div class="topbar-right">
            <HeaderLink href="/#about">about me</HeaderLink>
            <!-- <HeaderLink href="/#contact">contact</HeaderLink> -->
        </div>
        <button class="icon" id="mobile-menu-btn" aria-label="Toggle menu">
            <i class="fa fa-bars"></i>
        </button>
    </nav>
</header>

<style>
    header {
		margin: 0;
		padding: 0 4em;
		background: black;
        z-index: 1000;
        position: relative;
	}
    nav {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        position: relative;
        min-height: 4rem;
        /* padding: 0.8rem 3rem 0.8rem 3rem; */
    }

    h1 {
        color: white;
        font-weight: inherit;
        font-size: 1.5rem;
    }

    a {
        color: white;
        text-decoration: none;
        text-wrap: nowrap;
    }

    /* .topbar-right a {
        font-weight: lighter;
    } */

    .topbar-center a.active, .topbar-center a:hover {
		text-decoration: none;
        color: var(--accent);
	}

    .topbar-center {
        display: flex;
        gap: 1.5rem;
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
    }

    .topbar-right {
        display: flex;
        gap: 1.5rem;
    }

    #contact {
	    scroll-behavior: smooth;
    }

    nav .icon {
        display: none;
        background: none;
        border: none;
        color: white;
        font-size: 1.5rem;
        cursor: pointer;
        padding: 1rem 0;
    }

    @media screen and (max-width: 1080px) {
        header {
            padding: 0 2em;
        }

        .topbar-center, .topbar-right {
            display: none;
        }

        nav .icon {
            display: block;
        }
        
        nav.responsive {
            flex-direction: column;
            align-items: flex-start;
            padding-bottom: 1.5rem;
        }

        nav.responsive .icon {
            position: absolute;
            right: 0;
            top: 0;
        }

        nav.responsive .topbar-center, 
        nav.responsive .topbar-right {
            display: flex;
            flex-direction: column;
            position: static;
            transform: none;
            width: 100%;
            gap: 1rem;
            padding-top: 1rem;
        }
    }
    
</style>
<script>
    const btn = document.getElementById("mobile-menu-btn");
    const nav = document.getElementById("myTopnav");

    if (btn && nav) {
        btn.addEventListener("click", () => {
            nav.classList.toggle("responsive");
        });
    }
</script>
