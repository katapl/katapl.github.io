---
import HeaderLink from './HeaderLink.astro';
---

<header>
    <nav>
        <h1><a href="/">plesova_katerina</a></h1>
        <div class="topbar-center">
            <HeaderLink href="/ux">UX DESIGN</HeaderLink>
            <HeaderLink href="/art">ILLUSTRATION</HeaderLink>
            <HeaderLink href="/graphic-design">GRAPHIC DESIGN</HeaderLink>
        </div>
        <div class="topbar-right">
            <HeaderLink href="/#about">about me</HeaderLink>
            <!-- <HeaderLink href="/#contact">contact</HeaderLink> -->
        </div>
    </nav>
</header>

<style>
    header {
		margin: 0;
		padding: 0 4em;
		background: black;
	}
    nav {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        /* padding: 0.8rem 3rem 0.8rem 3rem; */
    }

    h1 {
        color: white;
        font-weight: inherit;
        font-size: 1.5rem;
    }

    a {
        color: white;
        text-decoration: none;
        text-wrap: nowrap;
    }

    /* .topbar-right a {
        font-weight: lighter;
    } */

    .topbar-center a.active, .topbar-center a:hover {
		text-decoration: none;
        color: var(--accent);
	}

    .topbar-center {
        display: flex;
        gap: 1.5rem;
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
    }

    .topbar-right {
        display: flex;
        gap: 1.5rem;
    }
/* 
    #contact {
	    scroll-behavior: smooth;
    } */
    
</style>